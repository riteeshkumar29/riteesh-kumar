using namespace std;

class Student {
public:
    int id;
    char name[50];
    float marks;

    void input() {
        cout << "Enter student ID: ";
        cin >> id;
        cout << "Enter student name: ";
        cin.ignore(); // to ignore the newline character left in the buffer
        cin.getline(name, 50);
        cout << "Enter marks: ";
        cin >> marks;
    }

    void display() {
        cout << "ID: " << id << ", Name: " << name << ", Marks: " << marks << endl;
    }
};

int main() {
    int n;
    cout << "Enter number of students: ";
    cin >> n;

    Student students[n]; 

    for (int i = 0; i < n; i++) {
        cout << "Enter details for student " << i + 1 << endl;
        students[i].input();
    }

    cout << "
Student details are:
";
    for (int i = 0; i < n; i++) {
        students[i].display();
    }

    return 0;
}
}
